---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProjectCase from "@/components/ProjectCase.astro";
import { projects, type Project } from "@/data/projects";

export const getStaticPaths = (() =>
  projects.map(project => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props { project: Project; }
const { project } = Astro.props;
const category = project.slug === "attribution-analysis" ? "数据分析Agent" : "知识服务RAG";
const sections = [
  { id: "highlights", title: "关键设计亮点" },
  { id: "cases", title: "具体案例拆解" },
  { id: "overview", title: "业务问题与目标" },
  { id: "contribution", title: "工程设计" },
  { id: "architecture", title: "处理流程" },
  { id: "modules", title: "模块设计" },
  { id: "reliability", title: "可靠性与取舍" },
  { id: "progress", title: "验证方法" },
  { id: "notes", title: "相关笔记" },
];
---

<Layout title={`${project.title} | Lucas_AI`} description={project.summary}>
  <Header />
  <main id="main-content" class="case-shell">
    <a href="/projects/" class="back-link"><span aria-hidden="true">←</span> 全部项目</a>
    <header class="case-hero">
      <div class="case-meta"><span>PROJECT / {project.number}</span><span class="case-category">{category}</span></div>
      <h1>{project.title}</h1>
      <p class="case-subtitle">{project.subtitle}</p>
      <p class="case-summary">{project.summary}</p>
      <ul class="case-tags" aria-label="技术与主题">{project.tags.map(tag => <li>{tag}</li>)}</ul>
    </header>

    <details class="mobile-toc">
      <summary>本页目录</summary>
      <nav aria-label="项目目录">{sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}</nav>
    </details>

    <div class="case-layout">
      <article class="case-content" data-pagefind-body>
        <section id="highlights">
          <p class="section-number">01 / KEY DECISIONS</p>
          <h2>关键设计亮点</h2>
          <div class="highlight-list">{project.highlights.map((item, index) => <div><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></div>)}</div>
          <a class="text-link" href="#cases">从具体问题看设计选择 <span aria-hidden="true">↓</span></a>
        </section>

        <section id="cases">
          <p class="section-number">02 / CASE BREAKDOWN</p>
          <h2>具体案例拆解</h2>
          <p>以业务场景和执行边界展开方案，逐项说明风险、设计选择与验证要点。</p>
          <div class="case-studies">{project.cases.map((study, index) => <ProjectCase {study} {index} />)}</div>
        </section>

        <section id="overview">
          <p class="section-number">03 / CONTEXT</p>
          <h2>业务问题与目标</h2>
          <p>{project.problem}</p>
          <dl class="fact-list"><div><dt>面向用户</dt><dd>{project.audience}</dd></div><div><dt>项目目标</dt><dd>{project.objective}</dd></div></dl>
        </section>

        <section id="contribution">
          <p class="section-number">04 / ENGINEERING DESIGN</p>
          <h2>工程设计</h2>
          <ul class="body-list">{project.contribution.map(item => <li>{item}</li>)}</ul>
        </section>

        <section id="architecture">
          <p class="section-number">05 / WORKFLOW</p>
          <h2>处理流程</h2>
          <ol class="flow-list">{project.flow.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{step}</li>)}</ol>
          <p class="flow-note">{project.flowNote}</p>
        </section>

        <section id="modules">
          <p class="section-number">06 / MODULES</p>
          <h2>模块设计</h2>
          <div class="module-list">{project.modules.map(module => <div class="module"><h3>{module.title}</h3><p>{module.description}</p></div>)}</div>
        </section>

        <section id="reliability">
          <p class="section-number">07 / RELIABILITY</p>
          <h2>可靠性与取舍</h2>
          <div class="reliability-list">{project.reliability.map((item, index) => <div><span class="reliability-number">{String(index + 1).padStart(2, "0")}</span><div><h3>{item.title}</h3><p>{item.description}</p></div></div>)}</div>
        </section>

        <section id="progress">
          <p class="section-number">08 / VALIDATION</p>
          <h2>验证方法</h2>
          <p>{project.slug === "attribution-analysis" ? "围绕经营问题，核对指标口径、SQL 结果、计算文件与报告依据，并为无数据、查询错误和超时分支设计检查项。" : "围绕原文、召回片段、回答引用与异常分支设计检查项，分别核查检索、生成和呈现环节。"}</p>
          <h3 class="acceptance-title">质量核查要点</h3>
          <ul class="body-list">{project.acceptance.map(item => <li>{item}</li>)}</ul>
        </section>

        <section id="notes">
          <p class="section-number">09 / FIELD NOTES</p>
          <h2>相关笔记</h2>
          <p>{project.takeaway}</p>
          <p class="reference-note">参考代码与方案说明架构思路；本人交付与验证结果另行记录。</p>
          <ul class="body-list">
            {
              project.slug === "support-knowledge-base" ? (
                <>
                  <li><a class="text-link" href="/posts/traceable-document-chunks/">从文档读取到可追溯切片 <span aria-hidden="true">↗</span></a></li>
                  <li><a class="text-link" href="/posts/citations-and-answer-quality/">同一错误码，不同版本：引用为何仍可能答错 <span aria-hidden="true">↗</span></a></li>
                </>
              ) : (
                <li><a class="text-link" href="/posts/attribution-analysis-design/">退款金额为什么增加：从指标口径到 SQL 复验 <span aria-hidden="true">↗</span></a></li>
              )
            }
          </ul>
        </section>
        <div class="case-end"><span>LUCAS_AI / PROJECT NOTES</span><a href="mailto:J1666830991@gmail.com">交流项目 <span aria-hidden="true">→</span></a></div>
      </article>

      <aside class="desktop-toc">
        <nav aria-label="项目目录">
          <p>本页目录</p>
          {sections.map((section, index) => <a href={`#${section.id}`}><span>{String(index + 1).padStart(2, "0")}</span>{section.title}</a>)}
          <a href="/projects/" class="toc-back">← 返回项目列表</a>
        </nav>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .case-shell { width: min(100% - 2rem, 70rem); margin-inline: auto; padding-block: 2.5rem 4rem; }
  .back-link { color: var(--muted-foreground); font-size: 0.8rem; text-decoration: none; display: inline-flex; gap: 0.6rem; align-items: center; }
  .back-link:hover { color: var(--accent); }
  .case-hero { padding-block: 2.7rem 2.4rem; max-width: 54rem; }
  .case-meta { display: flex; gap: 1.1rem; align-items: center; color: var(--muted-foreground); font: 0.7rem/1.5 "Cascadia Code", Consolas, monospace; letter-spacing: 0.1em; margin-bottom: 1.3rem; }
  .case-category { color: var(--accent); padding-left: 1.1rem; border-left: 1px solid var(--border); font-family: var(--font-app); letter-spacing: normal; }
  h1 { font-size: clamp(2rem, 4.8vw, 3.4rem); line-height: 1.35; letter-spacing: -0.035em; font-weight: 650; margin: 0; }
  .case-subtitle { color: var(--accent); font-size: 1.05rem; margin: 0.7rem 0 1.4rem; }
  .case-summary { color: var(--muted-foreground); max-width: 43rem; font-size: 0.95rem; line-height: 1.95; margin: 0; }
  .case-tags { list-style: none; padding: 0; margin: 1.5rem 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .case-tags li { border: 1px solid var(--border); border-radius: 0.25rem; padding: 0.28rem 0.6rem; font-size: 0.7rem; }
  .case-layout { display: grid; grid-template-columns: minmax(0, 1fr) 12.5rem; gap: 4.5rem; border-top: 1px solid var(--border); }
  .case-content { min-width: 0; }
  .case-content section { padding-block: 2.6rem; border-bottom: 1px solid var(--border); scroll-margin-top: 2rem; }
  .section-number { color: var(--muted-foreground); font: 0.65rem/1.5 "Cascadia Code", Consolas, monospace; letter-spacing: 0.1em; margin: 0 0 0.6rem; }
  h2 { font-size: 1.4rem; line-height: 1.5; letter-spacing: -0.02em; font-weight: 650; margin: 0 0 1.4rem; }
  h3 { font-size: 0.95rem; line-height: 1.7; font-weight: 600; margin: 0 0 0.45rem; }
  .case-content p:not(.section-number):not(.updated-note) { font-size: 0.9rem; line-height: 1.95; }
  .case-content section > p:not(.section-number):not(.updated-note) { color: var(--muted-foreground); margin: 0 0 1rem; }
  .highlight-list > div { display: flex; gap: 1.1rem; padding-block: 1.1rem; border-top: 1px solid var(--border); }
  .highlight-list > div > span { color: var(--accent); font: 0.7rem/1.8 ui-monospace, monospace; padding-top: 0.15rem; }
  .highlight-list p { color: var(--muted-foreground); margin: 0; }
  .fact-list { margin: 1.6rem 0 0; }
  .fact-list > div { display: grid; grid-template-columns: 5rem 1fr; gap: 1rem; padding-block: 0.8rem; border-top: 1px solid var(--border); font-size: 0.82rem; line-height: 1.9; }
  .fact-list dt { color: var(--muted-foreground); }
  .fact-list dd { margin: 0; }
  .body-list { margin: 0; padding-left: 1.2rem; }
  .body-list li { padding-left: 0.3rem; margin-block: 0.65rem; font-size: 0.88rem; line-height: 1.95; }
  .body-list li::marker { color: var(--accent); }
  .flow-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; padding: 0; margin: 0 0 1.5rem; gap: 0.65rem; }
  .flow-list li { display: flex; flex-direction: column; gap: 0.65rem; border: 1px solid var(--border); border-radius: 0.4rem; padding: 1rem; font-size: 0.83rem; font-weight: 550; }
  .flow-list li > span { color: var(--accent); font: 0.65rem/1.5 "Cascadia Code", Consolas, monospace; font-weight: 400; }
  .flow-note { color: var(--muted-foreground); }
  .module-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.8rem 1.5rem; }
  .module p { color: var(--muted-foreground); margin: 0; }
  .reliability-list > div { display: flex; gap: 1.1rem; margin-top: 1.5rem; }
  .reliability-number { font: 0.75rem/1.8 "Cascadia Code", Consolas, monospace; color: var(--accent); padding-top: 0.1rem; }
  .reliability-list p { color: var(--muted-foreground); margin: 0; }
  .acceptance-title { margin-top: 1.5rem; }
  .text-link { display: inline-flex; gap: 1rem; color: var(--accent); font-size: 0.82rem; text-underline-offset: 5px; margin-top: 0.3rem; }
  .case-end { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.5rem; }
  .case-end > span { color: var(--muted-foreground); font: 0.62rem/1.5 "Cascadia Code", Consolas, monospace; letter-spacing: 0.06em; }
  .case-end a { font-size: 0.8rem; color: var(--accent); text-decoration: none; }
  .desktop-toc { position: relative; padding-top: 2.6rem; }
  .desktop-toc nav { position: sticky; top: 2rem; }
  .desktop-toc nav > p { font-size: 0.72rem; font-weight: 600; margin: 0 0 1.2rem; }
  .desktop-toc a { display: flex; align-items: baseline; gap: 0.7rem; color: var(--muted-foreground); font-size: 0.74rem; text-decoration: none; line-height: 1.8; padding-block: 0.45rem; }
  .desktop-toc a > span { font: 0.6rem/1.5 "Cascadia Code", Consolas, monospace; color: var(--accent); }
  .desktop-toc a:hover { color: var(--accent); }
  .desktop-toc .toc-back { border-top: 1px solid var(--border); margin-top: 1.2rem; padding-top: 1rem; font-size: 0.7rem; }
  .mobile-toc { display: none; }
  @media (max-width: 960px) {
    .case-layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .desktop-toc { display: none; }
    .mobile-toc { display: block; border: 1px solid var(--border); border-radius: 0.4rem; padding: 0.85rem 1rem; margin-bottom: 1.7rem; }
    .mobile-toc summary { color: var(--accent); cursor: pointer; font-size: 0.82rem; }
    .mobile-toc nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem 1rem; padding-top: 1rem; }
    .mobile-toc a { color: var(--muted-foreground); font-size: 0.75rem; text-decoration: none; }
  }
  @media (max-width: 540px) {
    .case-shell { padding-block: 1.75rem 3rem; }
    .case-hero { padding-block: 2rem; }
    .case-content section { padding-block: 2rem; }
    .flow-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .module-list { grid-template-columns: 1fr; gap: 1.4rem; }
    .fact-list > div { grid-template-columns: 1fr; gap: 0.2rem; }
    .case-end { align-items: flex-start; flex-direction: column; }
  }
</style>
