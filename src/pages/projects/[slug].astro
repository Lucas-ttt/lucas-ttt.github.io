---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProjectCase from "@/components/ProjectCase.astro";
import RetrievalReplay from "@/components/RetrievalReplay.astro";
import RetrievalIteration from "@/components/RetrievalIteration.astro";
import RefundReconciliation from "@/components/RefundReconciliation.astro";
import { projects, type Project } from "@/data/projects";

export const getStaticPaths = (() =>
  projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isKnowledgeBase = project.slug === "support-knowledge-base";
const sections = [
  { id: "results", title: "运行结果" },
  { id: "cases", title: "实现与取舍" },
  { id: "reproduce", title: "本地复现" },
];

const materials = isKnowledgeBase
  ? [
      ...project.deliverables,
      { label: "检索回放数据", href: "/examples/agent-lab/replay_cases.json" },
      { label: "逐条评测数据", href: "/examples/agent-lab/retrieval_iteration_results.json" },
    ]
  : [
      { label: "下载复现示例", href: "/examples/agent-lab.zip" },
      { label: "退款对账脚本", href: "/examples/agent-lab/refund_reconciliation.py" },
      { label: "流水与对账结果", href: "/examples/agent-lab/refund_reconciliation_results.json" },
    ];
const queryExample = `Invoke-RestMethod http://127.0.0.1:8765/query -Method Post -ContentType 'application/json' -Body '{"query":"E102","version":"v2"}'`;
---

<Layout title={`${project.title} | Lucas_AI`} description={project.summary}>
  <Header />
  <main id="main-content" class="case-shell">
    <header class="project-intro">
      <h1>{project.title}</h1>
      <p class="project-status">{project.status}</p>
      <p class="status-detail">{project.statusDetail}</p>
    </header>

    <nav class="project-nav" aria-label="项目目录">
      {sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}
    </nav>

    <article class="case-content" data-pagefind-body>
      <section id="results">
        <h2>运行结果</h2>
        {isKnowledgeBase ? (
          <>
            <div id="replay"><RetrievalReplay /></div>
            <RetrievalIteration />
          </>
        ) : <RefundReconciliation />}
      </section>

      <section id="cases">
        <h2>实现与取舍</h2>
        <p class="section-intro" id="overview">{project.problem}</p>
        <div id="highlights" class="case-studies">
          {project.cases.map((study, index) => <ProjectCase {study} {index} />)}
        </div>

        <details id="architecture" class="project-detail">
          <summary>处理流程与模块</summary>
          <div class="detail-body">
            <ol class="flow-list">
              {project.flow.map(step => <li>{step}</li>)}
            </ol>
            <p class="detail-copy">{project.flowNote}</p>
            <ul class="body-list" id="contribution">
              {project.contribution.map(item => <li>{item}</li>)}
            </ul>
            <dl id="modules" class="definition-list">
              {project.modules.map(module => (
                <div><dt>{module.title}</dt><dd>{module.description}</dd></div>
              ))}
            </dl>
          </div>
        </details>

        <details id="scope" class="project-detail">
          <summary>已实现范围与待验证项</summary>
          <div class="detail-body">
            <dl class="definition-list stage-list">
              {project.stages.map(stage => (
                <div>
                  <dt>{stage.name} <span>{stage.status}</span></dt>
                  <dd>{stage.evidence}</dd>
                </div>
              ))}
            </dl>
            <dl id="reliability" class="definition-list">
              {project.reliability.map(item => (
                <div><dt>{item.title}</dt><dd>{item.description}</dd></div>
              ))}
            </dl>
          </div>
        </details>

        <details id="notes" class="project-detail">
          <summary>相关笔记</summary>
          <ul class="body-list detail-body">
            {isKnowledgeBase ? (
              <>
                <li><a href="/posts/knowledge-base-project/">知识库原型实践</a></li>
                <li><a href="/posts/rag-evaluation-records/#alias-retrieval">检索评测与字段别名实验</a></li>
              </>
            ) : <li><a href="/posts/reliable-tool-execution/">工具参数校验、有限重试与幂等</a></li>}
          </ul>
        </details>
      </section>

      <section id="reproduce">
        <h2>本地复现</h2>
        <p class="section-intro">
          解压示例包后，在 agent-lab 目录用 Python 3.12 或更新版本执行。
          以下命令使用自编资料，无需模型密钥。
        </p>
        <pre tabindex="0"><code>{isKnowledgeBase ? project.reproduce : "python refund_reconciliation.py --check"}</code></pre>
        <ul class="materials" aria-label="复现材料">
          {materials.map(item => (
            <li>
              <a href={item.href} download={/\.(zip|json)$/.test(item.href) ? true : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        {isKnowledgeBase && (
          <details id="local-query" class="project-detail">
            <summary>启动本地问答接口</summary>
            <div class="detail-body">
              <p class="detail-copy">
                启动后默认返回原文、版本证据、请求编号和分段耗时。生成、引用校验与超时回落使用本机模型替身验证。
              </p>
              <pre tabindex="0"><code>python answer_service.py</code></pre>
              <p class="detail-copy">在第二个 PowerShell 终端发送查询。</p>
              <pre tabindex="0"><code>{queryExample}</code></pre>
              <p class="detail-copy">
                连接兼容模型时，在启动前配置 <code>SUPPORT_CHAT_URL</code>、
                <code>SUPPORT_CHAT_MODEL</code>，接口需要认证时再配置
                <code>SUPPORT_CHAT_API_KEY</code>。
              </p>
            </div>
          </details>
        )}

        <details id="progress" class="project-detail">
          <summary>验证要点</summary>
          <ul class="body-list detail-body">
            {project.acceptance.map(item => <li>{item}</li>)}
          </ul>
        </details>
      </section>
    </article>
  </main>
  <Footer />
</Layout>

<script>
  function revealLinkedDetail() {
    let fragment = window.location.hash.slice(1);
    try {
      fragment = decodeURIComponent(fragment);
    } catch {
      return;
    }
    const target = document.getElementById(fragment);
    if (!target?.closest(".case-shell")) return;

    let revealed = false;
    let detail = target.closest("details");
    while (detail) {
      if (!detail.open) {
        detail.open = true;
        revealed = true;
      }
      detail = detail.parentElement?.closest("details") ?? null;
    }
    if (revealed) requestAnimationFrame(() => target.scrollIntoView({ block: "start" }));
  }

  revealLinkedDetail();
  document.addEventListener("astro:page-load", revealLinkedDetail);
  window.addEventListener("hashchange", revealLinkedDetail);
</script>

<style>
  .case-shell {
    width: min(100% - 2rem, 54rem);
    margin-inline: auto;
    padding-block: clamp(2rem, 4vw, 3.4rem) 4rem;
  }
  .project-intro {
    margin-bottom: 1.3rem;
  }
  h1 {
    font-size: clamp(1.9rem, 4.8vw, 3.15rem);
    line-height: 1.3;
    letter-spacing: -0.035em;
    font-weight: 650;
    margin: 0 0 0.75rem;
  }
  .project-status {
    display: inline-block;
    border: 1px solid var(--border);
    background: var(--muted);
    border-radius: 0.3rem;
    color: var(--accent);
    padding: 0.2rem 0.55rem;
    margin: 0 0 0.65rem;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .status-detail, .section-intro, .detail-copy {
    color: var(--muted-foreground);
    font-size: 0.88rem;
    line-height: 1.85;
    margin: 0 0 0.8rem;
  }
  .project-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.2rem;
    border-block: 1px solid var(--border);
    padding-block: 0.55rem;
  }
  .project-nav a, .materials a, .detail-body a {
    color: var(--accent);
    font-size: 0.83rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .case-content section {
    min-width: 0;
    padding-block: clamp(1.35rem, 4vw, 2.2rem);
    border-bottom: 1px solid var(--border);
  }
  .case-content [id] {
    scroll-margin-top: 1rem;
  }
  h2 {
    font-size: 1.35rem;
    line-height: 1.4;
    font-weight: 650;
    margin: 0 0 0.75rem;
  }
  .case-studies {
    margin-bottom: 1rem;
  }
  .project-detail {
    border-top: 1px solid var(--border);
  }
  .project-detail > summary {
    color: var(--accent);
    cursor: pointer;
    font-size: 0.86rem;
    font-weight: 600;
    padding-block: 0.75rem;
  }
  .detail-body {
    font-size: 0.85rem;
    line-height: 1.8;
    padding-bottom: 0.75rem;
  }
  .body-list {
    padding-left: 1.25rem;
    margin-block: 0.6rem;
  }
  .body-list li {
    margin-block: 0.35rem;
    font-size: 0.88rem;
    line-height: 1.8;
  }
  .body-list li::marker {
    color: var(--accent);
  }
  .flow-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    list-style: decimal inside;
    margin: 0 0 0.8rem;
    padding: 0;
    gap: 0.5rem;
  }
  .flow-list li {
    border: 1px solid var(--border);
    border-radius: 0.35rem;
    padding: 0.4rem 0.6rem;
  }
  .definition-list {
    margin: 0.8rem 0;
  }
  .definition-list > div {
    padding-block: 0.55rem;
    border-top: 1px solid var(--border);
  }
  .definition-list dt {
    font-weight: 600;
  }
  .definition-list dd {
    color: var(--muted-foreground);
    margin: 0.2rem 0 0;
  }
  .stage-list span {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 400;
    margin-inline-start: 0.45rem;
  }
  pre {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    padding: 0.75rem;
    margin: 0.55rem 0 0.85rem;
    background: var(--muted);
    font: 0.8rem/1.7 ui-monospace, monospace;
  }
  .materials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    padding: 0;
    margin: 0.5rem 0 1rem;
    list-style: none;
  }
</style>
