---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import RetrievalReplay from "@/components/RetrievalReplay.astro";
import { getPostUrl } from "@/utils/getPostPaths";

const featuredIds = ["retrieval-debugging", "rag-evaluation-records"];
const articles = await getCollection("posts", ({ id, data }) => featuredIds.includes(id) && !data.draft);
const featured = featuredIds.flatMap(id => articles.filter(article => article.id === id));
const refund: {
  change_cents: number;
  counterexample: { change_cents: number };
} = JSON.parse(readFileSync(resolve("public/examples/agent-lab/refund_reconciliation_results.json"), "utf8"));
const yuan = (cents: number) => new Intl.NumberFormat("zh-CN", { maximumFractionDigits: 2 }).format(cents / 100);
---

<Layout title="Lucas_AI · AI 应用开发" description="按版本检索排障资料，核对退款统计口径。两个可复现的 Python 项目和开发笔记。">
  <Header />
  <main id="main-content" class="app-layout home">
    <div class="intro">
      <h1>Lucas_AI <span>· AI 应用开发</span></h1>
      <p>我用 Python 做了按产品版本检索排障资料的知识库，以及一个可复现的退款对账实验。</p>
    </div>

    <section id="projects" class="projects" aria-label="项目">
      <article class="project primary-project">
        <h2>技术支持知识库</h2>
        <p class="description">切换产品版本，查看同一个错误码命中了哪条手册原文。</p>
        <RetrievalReplay compact />
        <a class="project-link" href="/projects/support-knowledge-base/">看检索实现 <span aria-hidden="true">→</span></a>
      </article>

      <article class="project">
        <h2>退款对账实验</h2>
        <p class="description">用两期自编退款流水对照成功时间和申请时间的统计结果。</p>
        <dl class="refund-results">
          <div>
            <dt>按成功时间统计</dt>
            <dd>增加 <strong>{yuan(refund.change_cents)} 元</strong></dd>
          </div>
          <div>
            <dt>误用申请时间</dt>
            <dd>增加 {yuan(refund.counterexample.change_cents)} 元</dd>
          </div>
        </dl>
        <a class="project-link" href="/projects/attribution-analysis/#refund-reconciliation">看对账过程 <span aria-hidden="true">→</span></a>
      </article>
    </section>

    <section class="notes" aria-labelledby="notes-title">
      <div class="notes-heading">
        <h2 id="notes-title">技术文章</h2>
        <a href="/posts/">全部文章 <span aria-hidden="true">→</span></a>
      </div>
      <ul>
        {featured.map(article => (
          <li>
            <a href={getPostUrl(article.id, article.filePath, Astro.currentLocale)}>
              {article.data.title}
              <span>{article.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .home {
    padding-block: clamp(1.5rem, 5vw, 3.7rem) 3.5rem;
  }

  .intro {
    margin-bottom: clamp(1.25rem, 4vw, 2.25rem);
  }

  h1 {
    font-size: clamp(1.6rem, 4.4vw, 2.75rem);
    font-weight: 740;
    letter-spacing: -.03em;
    line-height: 1.35;
  }

  h1 span, .description, .intro p {
    color: var(--muted-foreground);
  }

  .intro p {
    font-size: .94rem;
    line-height: 1.8;
    margin-top: .45rem;
    max-width: 42rem;
  }

  .projects {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 1rem;
    scroll-margin-top: 1rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: .62rem;
    background: var(--background);
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .primary-project {
    border-top: 3px solid var(--accent);
  }

  h2 {
    font-size: 1.3rem;
    font-weight: 660;
    line-height: 1.45;
  }

  .description {
    margin-top: .35rem;
    font-size: .87rem;
    line-height: 1.7;
  }

  .primary-project :global(.replay) {
    width: 100%;
  }

  .project-link {
    color: var(--accent);
    font-size: .89rem;
    font-weight: 650;
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    gap: .5rem;
    margin-top: auto;
    text-underline-offset: .2rem;
  }

  .project-link:hover, .notes a:hover {
    text-decoration: underline;
  }

  .refund-results {
    width: 100%;
    display: grid;
    gap: .7rem;
    margin: 1rem 0;
  }

  .refund-results div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: .25rem 1rem;
    border-top: 1px solid var(--border);
    padding-top: .65rem;
  }

  .refund-results dt {
    color: var(--muted-foreground);
    font-size: .82rem;
  }

  .refund-results dd {
    margin: 0;
    font-size: .9rem;
  }

  .refund-results strong {
    color: var(--accent);
  }

  .notes {
    margin-top: clamp(1.5rem, 5vw, 3rem);
  }

  .notes-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: .5rem;
  }

  .notes-heading a {
    color: var(--accent);
    flex-shrink: 0;
    font-size: .84rem;
  }

  .notes ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .notes li {
    border-bottom: 1px solid var(--border);
  }

  .notes li a {
    display: block;
    padding-block: .8rem;
    font-size: .96rem;
    font-weight: 620;
  }

  .notes li span {
    display: block;
    color: var(--muted-foreground);
    font-size: .82rem;
    font-weight: 400;
    margin-top: .2rem;
    line-height: 1.65;
  }

  @media (max-width: 700px) {
    .projects {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
