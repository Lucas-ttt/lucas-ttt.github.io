---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";
import { getReadingPosts } from "@/utils/getReadingPosts";
import { getPostUrl } from "@/utils/getPostPaths";
const notes = getReadingPosts(await getCollection("posts"));
const selectedNotes = notes.filter(post => post.data.featured);
const posts = (selectedNotes.length ? selectedNotes : notes).slice(0, 3);
const formatPostDate = (date: Date) =>
  date
    .toLocaleDateString("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      timeZone: "Asia/Shanghai",
    })
    .replaceAll("/", ".");
---

<Layout title="Lucas_AI · AI 工程实践与项目作品集">
  <Header />
  <main id="main-content" class="app-layout home-main">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="live-dot"></span> LUCAS_AI / AI 应用开发
        </p>
        <h1>从检索原型出发，<br />把实现<span>与结果讲清楚。</span></h1>
        <p class="hero-description">
          我是 Lucas_AI，关注企业知识服务与业务 Agent。<br
            class="desktop-break"
          />目前完成了带版本约束的离线知识检索原型，在这里记录代码、失败样例和工程取舍。
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/projects/support-knowledge-base/"
            >查看代表项目 <span>↗</span></a
          ><a class="button secondary" href="/resume/"
            >查看简历 <span>→</span></a>
        </div>
        <div class="hero-meta">
          <span>深圳 · AI 应用开发方向</span><i></i><a
            href="mailto:J1666830991@gmail.com">联系 Lucas_AI ↗</a>
        </div>
      </div>
      <div class="system-card" aria-label="离线知识检索原型的实际运行结果">
        <div class="system-top">
          <span class="terminal-dots"><i></i><i></i><i></i></span><span
            >LOCAL PROTOTYPE / VERIFIED OUTPUT</span>
        </div>
        <div class="system-body">
          <p class="system-caption">同一个错误码，先确认适用版本</p>
          <div class="input-node"><span>INPUT</span> E102 / 产品 v2</div>
          <div class="flow-line"></div>
          <div class="flow-stage">
            <span class="stage-number">↳</span><div>
              <strong>检查 customer_id 列</strong><small
                >来源 csv-v2 · 返回实际检索原文</small>
            </div><span class="stage-label">OK</span>
          </div>
          <div class="result-comparison">
            <p><span>换成 v1</span><strong>检查 user_id 列</strong></p><p>
              <span>未知版本 v9</span><strong>没有适用依据</strong>
            </p>
          </div>
          <div class="system-bottom">
            <span class="system-signal"></span> 3 份自编资料 · 无需模型密钥
          </div>
          <a
            class="system-source"
            href="/projects/support-knowledge-base/#results"
            >查看结果与复现方法 →</a
          >
        </div>
      </div>
    </section>
    <section class="projects-section" aria-labelledby="projects-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">SELECTED PROJECTS</p><h2 id="projects-title">
            先看成果，再看设计
          </h2>
        </div><a href="/projects/">查看全部项目 <span>↗</span></a>
      </div><div class="project-grid">
        {projects.map(project => <ProjectCard {project} />)}
      </div>
    </section>
    <section class="contribution-strip" aria-labelledby="contribution-title">
      <div>
        <p class="eyebrow">MY CONTRIBUTION</p><h2 id="contribution-title">
          让每个结果，都能回到实现
        </h2>
      </div><dl>
        <div>
          <dt>串起检索链路</dt><dd>
            读取、规范化、切片与词项索引，保留版本、来源和证据身份。
          </dd>
        </div><div>
          <dt>保留失败样例</dt><dd>
            用开发与留出问题对照 Top-K，记录口语改写未命中的情况。
          </dd>
        </div><div>
          <dt>收紧执行边界</dt><dd>
            统一项目与工具的检索规则，核查错误码前缀、版本和空结果。
          </dd>
        </div>
      </dl>
    </section>
    <section class="notes-section" aria-labelledby="notes-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">ENGINEERING NOTEBOOK</p><h2 id="notes-title">
            三篇精选实践
          </h2>
        </div><a href="/posts/">阅读 {notes.length} 篇笔记 <span>↗</span></a>
      </div><p class="notes-intro">
        从版本冲突、检索排错和小样本评测，了解具体实现与尚未解决的问题。
      </p><div class="notes-list">
        {
          posts.map((post, index) => (
            <a
              class="note-row"
              href={getPostUrl(post.id, post.filePath, Astro.currentLocale)}
            >
              <>
                <span class="note-number">
                  {String(post.data.seriesOrder ?? index + 1).padStart(2, "0")}
                </span>
                <div>
                  <>
                    <div class="note-tags">
                      {post.data.noteType} /{" "}
                      {post.data.tags.slice(0, 1).join(" / ")}
                      <time
                        class="note-archive-date"
                        datetime={(
                          post.data.modDatetime ?? post.data.pubDatetime
                        ).toISOString()}
                      >
                        更新{" "}
                        {formatPostDate(
                          post.data.modDatetime ?? post.data.pubDatetime
                        )}
                      </time>
                    </div>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                  </>
                </div>
                <span class="note-arrow">↗</span>
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section class="contact-strip">
      <div>
        <p class="eyebrow">LET’S BUILD SOMETHING USEFUL</p><h2>
          寻找 AI 应用开发与业务落地的机会
        </h2><p>欢迎围绕业务场景、系统设计与工程实现交流。</p>
      </div><a class="button primary" href="mailto:J1666830991@gmail.com"
        >邮件联系 <span>↗</span></a>
    </section>
  </main><Footer />
</Layout>
<style>
  .home-main {
    padding-bottom: 64px;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 65px;
    padding-block: 78px 76px;
  }
  .eyebrow {
    font-size: 10px;
    letter-spacing: 1.7px;
    font-weight: 650;
    color: var(--muted-foreground);
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  h1 {
    font-size: clamp(32px, 3.4vw, 46px);
    font-weight: 750;
    letter-spacing: -1.8px;
    line-height: 1.42;
    margin: 22px 0 20px;
  }
  h1 span {
    color: var(--accent);
  }
  .hero-description {
    color: var(--muted-foreground);
    font-size: 14px;
    line-height: 1.95;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 29px;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    font-size: 13px;
    font-weight: 550;
    padding: 11px 17px;
    border: 1px solid var(--border);
    border-radius: 5px;
    transition:
      transform 0.2s,
      background 0.2s;
  }
  .button:hover {
    transform: translateY(-2px);
  }
  .primary {
    background: var(--accent);
    color: var(--accent-foreground);
    border-color: var(--accent);
  }
  .secondary {
    background: transparent;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: 10px;
    color: var(--muted-foreground);
    margin-top: 27px;
  }
  .hero-meta i {
    height: 10px;
    width: 1px;
    background: var(--border);
  }
  .hero-meta a:hover {
    color: var(--accent);
  }
  .notes-intro {
    font-size: 12px;
    line-height: 1.9;
    color: var(--muted-foreground);
    margin: -8px 0 22px;
  }
  .note-archive-date {
    margin-left: 10px;
    color: var(--muted-foreground);
    white-space: nowrap;
  }
  .result-comparison {
    margin-top: 16px;
    border-top: 1px solid #ffffff18;
  }
  .result-comparison p {
    display: flex;
    gap: 15px;
    justify-content: space-between;
    padding-top: 12px;
    font-size: 11px;
  }
  .result-comparison p > span {
    color: #a1b8a7;
  }
  .result-comparison strong {
    font-weight: 500;
  }
  .system-source {
    display: inline-block;
    color: #c4dfb7;
    font-size: 11px;
    margin-top: 17px;
  }
  .system-source:hover {
    text-decoration: underline;
  }
  .contribution-strip {
    padding-top: 38px;
    margin-top: 38px;
    border-top: 1px solid var(--border);
  }
  .contribution-strip h2 {
    font-size: 23px;
    font-weight: 650;
    margin-top: 9px;
  }
  .contribution-strip dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin-top: 25px;
  }
  .contribution-strip dt {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .contribution-strip dd {
    font-size: 13px;
    line-height: 1.95;
    color: var(--muted-foreground);
    margin: 0;
  }
  .system-card {
    background: #1e332b;
    color: #e4ece7;
    border: 1px solid #334a3e;
    border-radius: 9px;
    box-shadow: 0 15px 40px #173c2410;
    transform: rotate(0.5deg);
  }
  .system-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #ffffff13;
    padding: 15px 17px;
    font:
      8px/1.4 ui-monospace,
      monospace;
    letter-spacing: 1px;
    color: #a0b2a7;
  }
  .terminal-dots {
    display: flex;
    gap: 5px;
  }
  .terminal-dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #5d7467;
  }
  .terminal-dots i:first-child {
    background: #a5ba8a;
  }
  .system-body {
    padding: 23px;
  }
  .system-caption {
    font-size: 10px;
    letter-spacing: 1px;
    color: #9bb3a4;
    margin-bottom: 16px;
  }
  .input-node {
    border: 1px solid #52715c;
    border-radius: 4px;
    padding: 13px 9px;
    font-size: 11px;
    background: #2a4234;
    white-space: nowrap;
  }
  .input-node span {
    color: #b8d1a7;
    font-family: monospace;
    font-size: 12px;
    margin-right: 8px;
  }
  .flow-line {
    height: 22px;
    margin-left: 17px;
    border-left: 1px dashed #6a8d72;
  }
  .flow-stage {
    display: flex;
    align-items: center;
    gap: 13px;
    background: #ffffff05;
    border: 1px solid #ffffff14;
    border-radius: 4px;
    padding: 12px;
  }
  .stage-number {
    font:
      10px ui-monospace,
      monospace;
    color: #91b19b;
  }
  .flow-stage strong {
    font-size: 12px;
    font-weight: 550;
    display: block;
  }
  .flow-stage small {
    font-size: 9px;
    display: block;
    color: #99b0a2;
    margin-top: 4px;
  }
  .stage-label {
    margin-left: auto;
    font:
      8px ui-monospace,
      monospace;
    letter-spacing: 1px;
    color: #b9d2a3;
  }
  .system-bottom {
    margin-top: 19px;
    font-size: 9px;
    color: #a1b8a7;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .system-signal {
    height: 5px;
    width: 5px;
    background: #91bc87;
    border-radius: 50%;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 15px;
    margin-bottom: 25px;
  }
  .section-heading h2 {
    font-size: 23px;
    font-weight: 650;
    letter-spacing: -0.5px;
    margin-top: 9px;
  }
  .section-heading > a {
    font-size: 12px;
    color: var(--muted-foreground);
    white-space: nowrap;
    padding-bottom: 3px;
  }
  .section-heading > a span {
    margin-left: 8px;
  }
  .section-heading > a:hover {
    color: var(--accent);
  }
  .projects-section {
    padding-top: 34px;
    border-top: 1px solid var(--border);
  }
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  .notes-section {
    margin-top: 62px;
  }
  .note-row {
    display: grid;
    grid-template-columns: 32px 1fr 20px;
    gap: 17px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }
  .notes-list {
    border-top: 1px solid var(--border);
  }
  .note-number {
    font:
      10px ui-monospace,
      monospace;
    color: var(--muted-foreground);
    padding-top: 5px;
  }
  .note-tags {
    font-size: 9px;
    color: var(--accent);
    letter-spacing: 0.5px;
  }
  .note-row h3 {
    font-size: 16px;
    font-weight: 600;
    margin-block: 5px 6px;
  }
  .note-row p {
    font-size: 12px;
    color: var(--muted-foreground);
    max-width: 700px;
  }
  .note-arrow {
    align-self: center;
    transition: transform 0.2s;
  }
  .note-row:hover h3 {
    color: var(--accent);
  }
  .note-row:hover .note-arrow {
    transform: translate(3px, -3px);
  }
  .contact-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    border: 1px solid var(--border);
    background: var(--muted);
    padding: 28px 30px;
    margin-top: 52px;
    border-radius: 6px;
  }
  .contact-strip h2 {
    font-size: 18px;
    letter-spacing: -0.4px;
    font-weight: 600;
    margin-top: 9px;
  }
  .contact-strip p:last-child {
    font-size: 12px;
    color: var(--muted-foreground);
    margin-top: 7px;
  }
  .contact-strip .button {
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .hero {
      gap: 28px;
      padding-block: 55px;
    }
    .system-body {
      padding: 18px;
    }
    .input-node {
      font-size: 10px;
    }
    .hero-meta {
      font-size: 9px;
    }
    .section-heading h2 {
      font-size: 21px;
    }
  }
  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 43px;
      gap: 34px;
    }
    h1 {
      font-size: 36px;
      margin-top: 17px;
    }
    .hero-description {
      font-size: 13px;
    }
    .system-card {
      max-width: 470px;
      width: 100%;
      transform: none;
    }
    .system-body {
      padding: 20px;
    }
    .input-node {
      font-size: 12px;
    }
    .project-grid {
      grid-template-columns: 1fr;
    }
    .contribution-strip dl {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .section-heading h2 {
      font-size: 20px;
    }
    .section-heading > a {
      font-size: 10px;
    }
    .contact-strip {
      align-items: start;
      flex-direction: column;
      padding: 23px;
    }
    .contact-strip h2 {
      font-size: 17px;
    }
    .notes-section {
      margin-top: 44px;
    }
    .note-row {
      grid-template-columns: 22px 1fr 16px;
      gap: 10px;
    }
    .note-row h3 {
      font-size: 15px;
    }
    .hero-meta {
      font-size: 10px;
    }
    .desktop-break {
      display: none;
    }
  }
</style>
