---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
const posts = getSortedPosts(await getCollection("posts")).slice(0,3);
---
<Layout title="Lucas_AI · AI 工程实践与项目作品集">
<Header/>
<main id="main-content" class="app-layout home-main">
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow"><span class="live-dot"></span> LUCAS_AI / 工程实践与项目记录</p><h1>让知识有据可查，<br/>让任务<span>有序执行。</span></h1><p class="hero-description">聚焦电商经营分析与企业知识服务。<br class="desktop-break"/>从业务场景到系统架构，展示 Agent 与 RAG 的工程设计和质量核查。</p><div class="hero-actions"><a class="button primary" href="/projects/">探索项目 <span>↗</span></a><a class="button secondary" href="/posts/">阅读工程笔记 <span>→</span></a></div><div class="hero-meta"><span>深圳 · AI 应用开发方向</span><i></i><a href="mailto:J1666830991@gmail.com">联系 Lucas_AI ↗</a></div></div>
    <div class="system-card" aria-label="知识检索与任务执行的项目设计示意"><div class="system-top"><span class="terminal-dots"><i></i><i></i><i></i></span><span>FROM KNOWLEDGE TO ACTION</span></div><div class="system-body"><p class="system-caption">两个场景，两类应用能力</p><div class="input-node"><span>Q</span> 企业知识与经营数据，如何用起来？</div><div class="flow-line"></div><div class="flow-stage"><span class="stage-number">01</span><div><strong>拆解经营指标</strong><small>提问 → 取数 → 分析报告</small></div><span class="stage-label">AGENT</span></div><div class="flow-line"></div><div class="flow-stage"><span class="stage-number">02</span><div><strong>找到知识依据</strong><small>文档 → 检索 → 引用核查</small></div><span class="stage-label">RAG</span></div><div class="system-bottom"><span class="system-signal"></span> 指标可回查 · 回答有依据</div></div></div>
  </section>
  <section class="projects-section" aria-labelledby="projects-title"><div class="section-heading"><div><p class="eyebrow">SELECTED PROJECTS</p><h2 id="projects-title">两个业务场景，两份项目案例</h2></div><a href="/projects/">查看全部项目 <span>↗</span></a></div><div class="project-grid">{projects.map(project=><ProjectCard {project}/>)}</div></section>
  <section class="notes-section" aria-labelledby="notes-title"><div class="section-heading"><div><p class="eyebrow">FIELD NOTES</p><h2 id="notes-title">工程笔记</h2></div><a href="/posts/">全部文章 <span>↗</span></a></div><div class="notes-list">{posts.map((post,index)=><a class="note-row" href={getPostUrl(post.id,post.filePath,Astro.currentLocale)}><span class="note-number">0{index+1}</span><div><div class="note-tags">{post.data.tags.slice(0,2).join(" / ")}</div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="note-arrow">↗</span></a>)}</div></section>
  <section class="contact-strip"><div><p class="eyebrow">LET’S BUILD SOMETHING USEFUL</p><h2>寻找 AI 应用开发与业务落地的机会</h2><p>欢迎围绕业务场景、系统设计与工程实现交流。</p></div><a class="button primary" href="mailto:J1666830991@gmail.com">邮件联系 <span>↗</span></a></section>
</main><Footer/>
</Layout>
<style>
.home-main{padding-bottom:64px}.hero{display:grid;grid-template-columns:1.3fr 1fr;align-items:center;gap:65px;padding-block:78px 76px}.eyebrow{font-size:10px;letter-spacing:1.7px;font-weight:650;color:var(--muted-foreground);display:flex;align-items:center;gap:9px}.live-dot{width:6px;height:6px;border-radius:50%;background:var(--accent)}h1{font-size:clamp(32px,3.4vw,46px);font-weight:750;letter-spacing:-1.8px;line-height:1.42;margin:22px 0 20px}h1 span{color:var(--accent)}.hero-description{color:var(--muted-foreground);font-size:14px;line-height:1.95}.hero-actions{display:flex;gap:12px;margin-top:29px}.button{display:inline-flex;align-items:center;justify-content:center;gap:24px;font-size:13px;font-weight:550;padding:11px 17px;border:1px solid var(--border);border-radius:5px;transition:transform .2s,background .2s}.button:hover{transform:translateY(-2px)}.primary{background:var(--accent);color:var(--accent-foreground);border-color:var(--accent)}.secondary{background:transparent}.hero-meta{display:flex;align-items:center;gap:11px;font-size:10px;color:var(--muted-foreground);margin-top:27px}.hero-meta i{height:10px;width:1px;background:var(--border)}.hero-meta a:hover{color:var(--accent)}
.system-card{background:#1e332b;color:#e4ece7;border:1px solid #334a3e;border-radius:9px;box-shadow:0 15px 40px #173c2410;transform:rotate(.5deg)}.system-top{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff13;padding:15px 17px;font:8px/1.4 ui-monospace,monospace;letter-spacing:1px;color:#a0b2a7}.terminal-dots{display:flex;gap:5px}.terminal-dots i{width:6px;height:6px;border-radius:50%;background:#5d7467}.terminal-dots i:first-child{background:#a5ba8a}.system-body{padding:23px}.system-caption{font-size:10px;letter-spacing:1px;color:#9bb3a4;margin-bottom:16px}.input-node{border:1px solid #52715c;border-radius:4px;padding:13px 9px;font-size:11px;background:#2a4234;white-space:nowrap}.input-node span{color:#b8d1a7;font-family:monospace;font-size:12px;margin-right:8px}.flow-line{height:22px;margin-left:17px;border-left:1px dashed #6a8d72}.flow-stage{display:flex;align-items:center;gap:13px;background:#ffffff05;border:1px solid #ffffff14;border-radius:4px;padding:12px}.stage-number{font:10px ui-monospace,monospace;color:#91b19b}.flow-stage strong{font-size:12px;font-weight:550;display:block}.flow-stage small{font-size:9px;display:block;color:#99b0a2;margin-top:4px}.stage-label{margin-left:auto;font:8px ui-monospace,monospace;letter-spacing:1px;color:#b9d2a3}.system-bottom{margin-top:19px;font-size:9px;color:#a1b8a7;display:flex;align-items:center;gap:6px}.system-signal{height:5px;width:5px;background:#91bc87;border-radius:50%}
.section-heading{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:25px}.section-heading h2{font-size:23px;font-weight:650;letter-spacing:-.5px;margin-top:9px}.section-heading>a{font-size:12px;color:var(--muted-foreground);white-space:nowrap;padding-bottom:3px}.section-heading>a span{margin-left:8px}.section-heading>a:hover{color:var(--accent)}.projects-section{padding-top:34px;border-top:1px solid var(--border)}.project-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.notes-section{margin-top:62px}.note-row{display:grid;grid-template-columns:32px 1fr 20px;gap:17px;padding:24px 0;border-bottom:1px solid var(--border)}.notes-list{border-top:1px solid var(--border)}.note-number{font:10px ui-monospace,monospace;color:var(--muted-foreground);padding-top:5px}.note-tags{font-size:9px;color:var(--accent);letter-spacing:.5px}.note-row h3{font-size:16px;font-weight:600;margin-block:5px 6px}.note-row p{font-size:12px;color:var(--muted-foreground);max-width:700px}.note-arrow{align-self:center;transition:transform .2s}.note-row:hover h3{color:var(--accent)}.note-row:hover .note-arrow{transform:translate(3px,-3px)}.contact-strip{display:flex;align-items:center;justify-content:space-between;gap:22px;border:1px solid var(--border);background:var(--muted);padding:28px 30px;margin-top:52px;border-radius:6px}.contact-strip h2{font-size:18px;letter-spacing:-.4px;font-weight:600;margin-top:9px}.contact-strip p:last-child{font-size:12px;color:var(--muted-foreground);margin-top:7px}.contact-strip .button{white-space:nowrap}
@media(max-width:900px){.hero{gap:28px;padding-block:55px}.system-body{padding:18px}.input-node{font-size:10px}.hero-meta{font-size:9px}.section-heading h2{font-size:21px}}
@media(max-width:700px){.hero{grid-template-columns:1fr;padding-block:43px;gap:34px}h1{font-size:36px;margin-top:17px}.hero-description{font-size:13px}.system-card{max-width:470px;width:100%;transform:none}.system-body{padding:20px}.input-node{font-size:12px}.project-grid{grid-template-columns:1fr}.section-heading h2{font-size:20px}.section-heading>a{font-size:10px}.contact-strip{align-items:start;flex-direction:column;padding:23px}.contact-strip h2{font-size:17px}.notes-section{margin-top:44px}.note-row{grid-template-columns:22px 1fr 16px;gap:10px}.note-row h3{font-size:15px}.hero-meta{font-size:10px}.desktop-break{display:none}}
</style>
