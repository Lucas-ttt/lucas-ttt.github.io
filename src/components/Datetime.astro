---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";
import { resolveTimezone } from "@/utils/resolveTimezone";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  noteType?: string;
  archiveDatetime?: string | Date;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
  noteType,
  archiveDatetime,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

const isModified = modDatetime && modDatetime > pubDatetime;

const datetime = dayjs(isModified ? modDatetime : pubDatetime).tz(
  resolveTimezone(postTimezone ?? config.site.timezone)
);

const date = datetime.format("YYYY.MM.DD");
const archiveDate = archiveDatetime
  ? dayjs(archiveDatetime).tz(resolveTimezone(postTimezone ?? config.site.timezone))
  : null;
---

<div
  class:list={["text-muted-foreground flex flex-wrap items-center gap-x-2 gap-y-1", className]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {
    (archiveDate || isModified || noteType) && (
      <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
        {archiveDate ? "归档日期" : isModified ? t.post.updatedAt : "整理于"}:
      </span>
    )
  }
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={(archiveDate ?? datetime).toISOString()}
    data-date-kind={archiveDate ? "archive" : "actual"}
  >
    {archiveDate ? archiveDate.format("YYYY.MM.DD") : date}
  </time>
  {archiveDate && size === "lg" && <span class="text-sm"><span aria-hidden="true">· </span>{isModified ? "更新于" : "整理于"} <time datetime={datetime.toISOString()} data-date-kind="actual">{date}</time></span>}
</div>
