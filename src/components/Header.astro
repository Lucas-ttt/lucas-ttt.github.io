---
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
const current = Astro.url.pathname;
const links = [
  { url: "/#projects", label: "项目", active: current === "/" || current.startsWith("/projects/") },
  { url: "/posts/", label: "技术文章", active: current.startsWith("/posts/") },
  { url: "/resume/", label: "简历", active: current.startsWith("/resume/") },
];
---
<a class="skip-link" href="#main-content">跳转到内容</a>
<header class="site-header">
  <div class="app-layout header-inner">
    <a href="/" class="brand" aria-label="Lucas_AI 首页"><span class="brand-icon">L<span>_</span></span><span>Lucas<span class="brand-ai">_AI</span></span></a>
    <nav aria-label="主导航">
      {links.map(link => <a href={link.url} aria-current={link.active ? (link.url.includes("#") ? "location" : "page") : undefined}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <a href="/search/" class="search-link" aria-label="搜索文章" title="搜索文章"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg></a>
      <button id="theme-btn" class="theme-button" title="切换深浅色" aria-label="切换深浅色" aria-live="polite"><IconMoon class="moon-icon"/><IconSunHigh class="sun-icon"/></button>
    </div>
  </div>
</header>
<style>
.site-header{border-bottom:1px solid var(--border);background:var(--background)}
.header-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:64px}
.brand{display:flex;align-items:center;gap:10px;font-size:20px;font-weight:750;letter-spacing:-.6px;white-space:nowrap}
.brand-icon{width:31px;height:31px;background:var(--foreground);color:var(--background);font:700 21px/31px monospace;text-align:center;border-radius:7px}.brand-icon span{color:#a2d0a9}.brand-ai{color:var(--accent)}
nav{display:flex;gap:24px}nav a{font-size:14px;white-space:nowrap;color:var(--muted-foreground);padding:9px 0}nav a:hover,nav a[aria-current]{color:var(--foreground)}nav a[aria-current]{box-shadow:0 2px 0 var(--accent)}
.header-actions{display:flex;align-items:center;gap:3px}.search-link,.theme-button{width:36px;height:36px;display:grid;place-items:center;color:var(--muted-foreground);border-radius:.35rem}.search-link:hover,.theme-button:hover{background:var(--muted);color:var(--foreground)}.theme-button svg{width:19px;height:19px}.sun-icon{display:none}:global([data-theme="dark"]) .sun-icon{display:block}:global([data-theme="dark"]) .moon-icon{display:none}
.skip-link{position:absolute;top:-100px;z-index:100;background:var(--background);padding:12px}.skip-link:focus{top:0}
@media(max-width:700px){.header-inner{gap:10px;min-height:58px}.brand{font-size:16px;gap:6px}.brand-icon{width:26px;height:26px;font-size:18px;line-height:26px}nav{gap:12px}nav a{font-size:12px}.search-link,.theme-button{width:30px;height:36px}}
@media(max-width:355px){.header-inner{flex-wrap:wrap;padding-block:.45rem;gap:3px 10px}nav{order:3;width:100%;gap:20px}}
</style>
