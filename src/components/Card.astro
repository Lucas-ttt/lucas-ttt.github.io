---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  compact?: boolean;
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", compact = false, id, data, filePath } = Astro.props;

const { title, description, ...props } = data;
---

<li class:list={["border-b border-border", compact ? "py-4 last:border-b-0" : "my-8 pb-7"]} data-series-order={data.seriesOrder}>
  {!compact && data.series && <div class="mb-2 flex flex-wrap items-center gap-3 text-xs text-muted-foreground"><a href="/posts/#series" class="text-accent">{data.series} · {String(data.seriesOrder).padStart(2, "0")}</a><span>{data.noteType}</span></div>}
  <div class:list={[{ "flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1": compact }]}>
    <a
      href={getPostUrl(id, filePath, Astro.currentLocale)}
      class:list={[
        "text-accent inline-block text-lg font-medium",
        "decoration-dashed underline-offset-4 hover:underline",
        "focus-visible:no-underline focus-visible:underline-offset-0",
      ]}
    >
      <Heading transition:name={toTransitionName(id)}>
        {title}
      </Heading>
    </a>
    <Datetime {...props} />
  </div>
  <p class:list={[{ "mt-1 text-sm leading-relaxed text-muted-foreground": compact }]}>{description}</p>
</li>
