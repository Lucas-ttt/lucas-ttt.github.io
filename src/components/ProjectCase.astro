---
import type { ProjectCaseStudy } from "@/data/projects";

interface Props {
  study: ProjectCaseStudy;
  index: number;
}
const { study, index } = Astro.props;
const evidenceTitle = study.label.startsWith("已运行")
  ? "运行材料"
  : "预期核查产物";
---

<details class="case-study" id={`case-${study.id}`} open={index === 0}>
  <summary>
    <span class="case-count">{String(index + 1).padStart(2, "0")}</span>
    <span class="summary-copy"
      ><span class="study-label">{study.label}</span><span class="study-title"
        >{study.title}</span
      ></span
    >
    <svg
      class="disclosure"
      aria-hidden="true"
      viewBox="0 0 20 20"
      width="20"
      height="20"
      fill="none"
      ><path
        d="m5 8 5 5 5-5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path></svg
    >
  </summary>
  <div class="study-body">
    <blockquote><span>用户问题</span><p>{study.question}</p></blockquote>
    <p class="study-context">{study.context}</p>
    <dl class="decision-list">
      <div><dt>容易出错的地方</dt><dd>{study.risk}</dd></div>
      <div><dt>设计选择</dt><dd>{study.decision}</dd></div>
    </dl>
    <div class="validation-grid">
      <div>
        <h3>怎样验证</h3><ol>{study.checks.map(item => <li>{item}</li>)}</ol>
      </div>
      <div>
        <h3>{evidenceTitle}</h3><ul>
          {study.evidence.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>
    <p class="study-takeaway"><span>设计取舍</span>{study.takeaway}</p>
  </div>
</details>

<style>
  .case-study {
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    margin-top: 1rem;
    overflow: clip;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 1.35rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--muted);
  }
  summary:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: -5px;
  }
  .case-count {
    color: var(--accent);
    font:
      0.7rem/1.5 ui-monospace,
      monospace;
  }
  .summary-copy {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 0.3rem;
  }
  .study-label {
    font-size: 0.66rem;
    color: var(--muted-foreground);
  }
  .study-title {
    font-size: 1rem;
    line-height: 1.6;
    font-weight: 600;
  }
  .disclosure {
    color: var(--accent);
    flex-shrink: 0;
    transition: transform 150ms ease;
  }
  details[open] .disclosure {
    transform: rotate(180deg);
  }
  details[open] summary {
    border-bottom: 1px solid var(--border);
  }
  .study-body {
    padding: 1.4rem 1.35rem;
  }
  blockquote {
    margin: 0;
    border-left: 2px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1rem;
  }
  blockquote span {
    color: var(--accent);
    font-size: 0.68rem;
  }
  blockquote p {
    font-size: 1rem;
    line-height: 1.85;
    margin: 0.35rem 0 0;
    font-weight: 550;
  }
  .study-context {
    font-size: 0.76rem;
    color: var(--muted-foreground);
    line-height: 1.85;
    margin: 1rem 0 1.3rem;
  }
  .decision-list {
    margin: 0;
  }
  .decision-list > div {
    padding-block: 1rem;
    border-top: 1px solid var(--border);
  }
  dt,
  h3 {
    font-size: 0.76rem;
    font-weight: 600;
    margin: 0 0 0.45rem;
  }
  dd {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.95;
    color: var(--muted-foreground);
  }
  .validation-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }
  ol,
  ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  ol {
    list-style-type: decimal;
  }
  ul {
    list-style-type: disc;
  }
  li {
    font-size: 0.8rem;
    line-height: 1.95;
    padding-left: 0.2rem;
    margin-block: 0.4rem;
    color: var(--muted-foreground);
  }
  li::marker {
    color: var(--accent);
  }
  .study-takeaway {
    margin: 1.3rem 0 0;
    padding: 0.9rem 1rem;
    background: var(--muted);
    border-radius: 0.35rem;
    font-size: 0.8rem;
    line-height: 1.9;
  }
  .study-takeaway span {
    display: block;
    font-size: 0.65rem;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }
  @media (max-width: 600px) {
    summary {
      padding: 1rem;
      gap: 0.7rem;
    }
    .study-title {
      font-size: 0.92rem;
    }
    .study-body {
      padding: 1.2rem 1rem;
    }
    .validation-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .disclosure {
      transition: none;
    }
  }
</style>
